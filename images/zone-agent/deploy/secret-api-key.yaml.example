# API key delivery for `auth = "api-key"` model profiles. Prefer broker
# (per-user Entra) profiles wherever possible: no secret to rotate, calls
# are attributable to the user. Keys are the fallback for resources where
# per-user RBAC is not (yet) possible.
#
# Provision from your secret store (e.g. sealed-secrets / external-secrets
# against the enterprise vault) rather than committing real values; this
# file only documents the shape zone-agent expects.
apiVersion: v1
kind: Secret
metadata:
  name: zone-agent-api-key
  namespace: CHANGE-ME-user-namespace
type: Opaque
stringData:
  AZURE_OPENAI_API_KEY: "CHANGE-ME"
