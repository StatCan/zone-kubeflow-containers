#!/command/with-contenv bash

echo "--------------------Starting up--------------------"

# create directory to store env vars for s6-overlay
S6_ENV="/run/s6-env"
[ -d "${S6_ENV}" ] || mkdir -p "${S6_ENV}"

export NB_NAMESPACE=$(echo $NB_PREFIX | awk -F '/' '{print $3}')
echo ${NB_NAMESPACE} > ${S6_ENV}/NB_NAMESPACE

export JWT="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
echo ${JWT} > ${S6_ENV}/JWT

# Setup environment variables for R and Rstudio
echo "NB_PREFIX=${NB_PREFIX}" >> /opt/conda/lib/R/etc/Renviron
echo "NB_NAMESPACE=$NB_NAMESPACE" >> /opt/conda/lib/R/etc/Renviron
echo "NLS_LANG=$NLS_LANG" >> /opt/conda/lib/R/etc/Renviron
printenv | grep KUBERNETES >> /opt/conda/lib/R/etc/Renviron
echo "SPARK_HOME=${SPARK_HOME}" >> /opt/conda/lib/R/etc/Renviron
echo "R_ZIPCMD=zip" >> /opt/conda/lib/R/etc/Renviron
# Filer related env vars for R & Rstudio
printenv | grep svm >> /opt/conda/lib/R/etc/Renviron

# Retrieve service account details with one request to the API server (each
# `kubectl get` paid a CLI start plus API discovery before it could run)
secret=$(curl -fsS --cacert /var/run/secrets/kubernetes.io/serviceaccount/ca.crt \
  -H "Authorization: Bearer ${JWT}" \
  "https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT}/api/v1/namespaces/${NB_NAMESPACE}/secrets/artifactory-creds")
serviceaccountname=$(jq -r '.data.Username // empty | @base64d' <<< "${secret}")
serviceaccounttoken=$(jq -r '.data.Token // empty | @base64d' <<< "${secret}")
# Point conda to Artifactory repository. The public channel is removed at build
# time (images/mid/Dockerfile); writing this file directly avoids starting conda.
mkdir -p /opt/conda/condarc.d
cat > /opt/conda/condarc.d/artifactory.yml << EOF
channels:
  - https://$serviceaccountname:$serviceaccounttoken@artifactory.cloud.statcan.ca/artifactory/api/conda/conda-forge-remote/
EOF

pip config set global.index-url https://$serviceaccountname:$serviceaccounttoken@artifactory.cloud.statcan.ca/artifactory/api/pypi/pypi/simple

# create pixi config to change default channel
if [ ! -d "/home/${NB_USER}/.pixi/config.toml" ]; then
  echo "Creating pixi config"
  cat > /home/${NB_USER}/.pixi/config.toml << EOF
default-channels = ["https://$serviceaccountname:$serviceaccounttoken@artifactory.cloud.statcan.ca/artifactory/api/conda/conda-forge-remote/"]
EOF
fi

echo "Configuring Rprofile.site..."

# Read both from files rather than starting lsb_release (Python) and R
UBUNTU_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME}")
R_VERSION=$(sed -n 's/^Version: \([0-9]*\.[0-9]*\).*/\1/p' /opt/conda/lib/R/library/base/DESCRIPTION 2>/dev/null)

if [ -z "$R_VERSION" ] || [ -z "$UBUNTU_CODENAME" ]; then
    echo "WARNING: Failed to detect R version or Ubuntu codename. Skipping R repository configuration."
else
    PPM_URL="https://${serviceaccountname}:${serviceaccounttoken}@artifactory.cloud.statcan.ca/artifactory/zone-r-ppm-bin-${UBUNTU_CODENAME}-${R_VERSION}-remote"
    CRAN_LOCAL_URL="https://${serviceaccountname}:${serviceaccounttoken}@artifactory.cloud.statcan.ca/artifactory/cran-local"

    cat >> /opt/conda/lib/R/etc/Rprofile.site << EOF

local({
    r <- getOption("repos")
    r["ppm"] <- "$PPM_URL"
    r["cran-local"] <- "$CRAN_LOCAL_URL"
    options(repos = r)
})
EOF

    echo "Rprofile.site updated successfully."
fi

# Configure the language
if [ -n "${KF_LANG}" ]; then
    if [ "${KF_LANG}" = "en" ]; then
        export LANG="en_US.utf8"
        echo ${LANG} > ${S6_ENV}/LANG
    else
        export LANG="fr_FR"
        echo ${LANG} > ${S6_ENV}/LANG

        lang_file="/home/${NB_USER}/.jupyter/lab/user-settings/@jupyterlab/translation-extension/plugin.jupyterlab-settings"
        if [ ! -e ${lang_file} ]; then
          mkdir -p "$(dirname "${lang_file}")" && touch $lang_file
          ( echo    '{'
            echo     '   // Langue'
            echo     '   // @jupyterlab/translation-extension:plugin'
            echo     '   // Paramètres de langue.'
            echo  -e '   // ****************************************\n'
            echo     '   // Langue locale'
            echo     '   // Définit la langue d'\''affichage de l'\''interface. Exemples: '\''es_CO'\'', '\''fr'\''.'
            echo     '   "locale": "'${LANG}'"'
            echo     '}'
          ) > $lang_file
        fi

        vscode_language="${CS_DEFAULT_HOME}/User/argv.json"
        if [ ! -e ${vscode_language} ]; then
          echo "{\"locale\":\"fr\"}" >> $vscode_language
        fi
    fi
fi

echo "language has been configured"
