#!/bin/bash
#
# zone-browser -- drive the secure browser that runs INSIDE this notebook pod.
#
# A headless Chromium (the Playwright build bundled under /opt/ms-playwright)
# runs inside the pod. Its screen appears as a tab INSIDE JupyterLab -- the
# "Zone Browser" Launcher tile, backed by zone-browser-viewer.py over the
# Chrome DevTools Protocol. There is no X server and no VNC. Interactive
# Entra ID sign-in (`az login`, azure-identity, R AzureAuth, ...) happens
# entirely in the pod's Chromium on the pod's network -- never in the user's
# local browser.
#
# The image sets BROWSER=/usr/local/bin/zone-browser, so Python's webbrowser
# module (used by az/MSAL/azure-identity) invokes this script automatically.
#
# Usage:
#   zone-browser <url>        show <url> in the in-pod browser
#   zone-browser              show https://microsoft.com/devicelogin
#   zone-browser --status     report what is running
#   zone-browser --stop       stop the in-pod browser
#   zone-browser --ensure     start Chromium if needed (used by the viewer)
#   zone-browser --serve <p>  run the viewer bridge in the foreground on port
#                             <p>; jupyter-server-proxy entry point that backs
#                             the "Zone Browser" JupyterLab tile
#   zone-browser --dump       save what the browser is showing right now
#                             (screenshot + page HTML + URL) for support
#   zone-browser --selftest   start, probe and stop everything (CI)
#
# Tunables (set before first use):
#   ZONE_BROWSER_CDP_PORT     Chromium DevTools port       (default 9222)
#   ZONE_BROWSER_SIZE         browser window size          (default 1440,900)
#   ZONE_BROWSER_TTL_MINUTES  idle minutes before shutdown (default 15)
#   ZONE_BROWSER_CHROMIUM     path to a chromium binary    (default: bundled)
#   ZONE_BROWSER_UA           user-agent override (ADFS/WIA workaround)
#   ZONE_EXTERNAL_URL         https://<zone host>, used to print a clickable link

set -u

SELF="$(readlink -f "$0")"
VIEWER="${ZONE_BROWSER_VIEWER:-/usr/local/bin/zone-browser-viewer.py}"
CDP_PORT="${ZONE_BROWSER_CDP_PORT:-9222}"
WINDOW_SIZE="${ZONE_BROWSER_SIZE:-1440,900}"
TTL_MINUTES="${ZONE_BROWSER_TTL_MINUTES:-15}"
RUN_DIR="/tmp/zone-browser-$(id -u)"
export ZONE_BROWSER_RUN_DIR="$RUN_DIR"
export ZONE_BROWSER_BIN="$SELF"
export ZONE_BROWSER_CDP="http://127.0.0.1:${CDP_PORT}"

mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"

usage() {
    sed -n '2,37s/^# \{0,1\}//p' "$SELF"
}

find_chromium() {
    if [ -n "${ZONE_BROWSER_CHROMIUM:-}" ]; then
        echo "$ZONE_BROWSER_CHROMIUM"
        return
    fi
    # x64 gets Chrome-for-Testing builds (chrome-linux64/), other arches the
    # classic Playwright build (chrome-linux/) -- match both layouts.
    ls -1d /opt/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | sort -V | tail -1
}

pid_alive() { # pid_alive <name>
    local pid_file="$RUN_DIR/$1.pid"
    [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

start_daemon() { # start_daemon <name> <cmd...>
    local name="$1"
    shift
    setsid "$@" </dev/null >>"$RUN_DIR/$name.log" 2>&1 &
    echo $! >"$RUN_DIR/$name.pid"
}

wait_for() { # wait_for <description> <probe command...>, ~15s budget
    local what="$1"
    shift
    for _ in $(seq 1 75); do
        "$@" 2>/dev/null && return 0
        sleep 0.2
    done
    echo "zone-browser: timed out waiting for $what (see $RUN_DIR/*.log)" >&2
    return 1
}

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

seed_nss_certs() {
    # Chromium trusts ~/.pki/nssdb, not REQUESTS_CA_BUNDLE; import the same
    # StatCan certificates the image adds for python so intercepted TLS works.
    command -v certutil >/dev/null 2>&1 || return 0
    local db="$HOME/.pki/nssdb" crt
    mkdir -p "$db"
    [ -f "$db/cert9.db" ] || certutil -d "sql:$db" -N --empty-password 2>/dev/null
    for crt in /opt/conda/ssl/certs/*.crt; do
        [ -e "$crt" ] || break
        certutil -d "sql:$db" -A -t "C,," -n "zone-$(basename "$crt")" -i "$crt" 2>/dev/null
    done
    return 0
}

ensure_chromium() {
    exec 9>"$RUN_DIR/lock"
    flock 9
    if ! pid_alive chromium; then
        local chrome
        chrome="$(find_chromium)"
        if [ -z "$chrome" ] || [ ! -x "$chrome" ]; then
            echo "zone-browser: bundled Chromium not found under /opt/ms-playwright" >&2
            echo "zone-browser: set ZONE_BROWSER_CHROMIUM to a chromium binary" >&2
            return 1
        fi
        # ZONE_BROWSER_UA: override the user agent. From inside the StatCan
        # network, GC SSO's ADFS serves its Windows-Integrated-Auth endpoint
        # (/adfs/ls/wia) to user agents it deems WIA-capable; the pod has no
        # Kerberos ticket, so that dead-ends in a blank page. A UA outside
        # the ADFS WIASupportedUserAgents list falls back to forms sign-in.
        local extra_args=()
        if [ -n "${ZONE_BROWSER_UA:-}" ]; then
            extra_args+=("--user-agent=${ZONE_BROWSER_UA}")
        fi
        start_daemon chromium "$chrome" \
            --headless=new \
            --remote-debugging-port="$CDP_PORT" \
            --remote-allow-origins='*' \
            --no-sandbox --disable-gpu --disable-dev-shm-usage \
            --no-first-run --no-default-browser-check \
            --password-store=basic \
            --user-data-dir="$RUN_DIR/profile" \
            --window-size="$WINDOW_SIZE" \
            "${extra_args[@]}" \
            about:blank
        wait_for "Chromium DevTools on port ${CDP_PORT}" port_open "$CDP_PORT" || return 1
    fi
    flock -u 9
    return 0
}

start_watchdog() {
    # Stop Chromium once nothing has used it for TTL_MINUTES, so an idle
    # browser does not hold memory until pod restart. The viewer bridge stays
    # up (jupyter-server-proxy owns it, and Lab frontends hold its /events
    # channel open) and restarts Chromium on the next use. The viewer
    # refreshes last-used while a Zone Browser tab is actually being used.
    pid_alive watchdog && return 0
    start_daemon watchdog bash -c '
        while true; do
            sleep 60
            pid_file="'"$RUN_DIR"'/chromium.pid"
            [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null || continue
            last=$(stat -c %Y "'"$RUN_DIR"'/last-used" 2>/dev/null || echo 0)
            if [ $(( $(date +%s) - last )) -ge '"$((TTL_MINUTES * 60))"' ]; then
                kill -- "-$(cat "$pid_file")" 2>/dev/null || kill "$(cat "$pid_file")" 2>/dev/null
                rm -f "$pid_file"
            fi
        done'
}

do_stop() {
    local name pid
    for name in watchdog viewer chromium; do
        if [ -f "$RUN_DIR/$name.pid" ]; then
            pid="$(cat "$RUN_DIR/$name.pid")"
            # the watchdog reaches here via `exec $SELF --stop`: never kill self.
            # Daemons are setsid group leaders, so signal the whole group to
            # take their children (e.g. the watchdog's sleep) down with them.
            [ "$pid" != "$$" ] && { kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null; }
            rm -f "$RUN_DIR/$name.pid"
        fi
    done
    rm -f "$RUN_DIR/viewer.port"
    echo "zone-browser: stopped."
    return 0
}

link_path() {
    local prefix="${NB_PREFIX:-}"
    prefix="${prefix%/}"
    echo "${prefix}/zone-browser/"
}

print_banner() {
    # Deliberately contains no URL: a printed link would be opened by the
    # user's local browser, which is exactly what this flow avoids. The
    # Azure CLI prints its own login.microsoftonline.com URL above this
    # banner and we cannot suppress it, so warn against it explicitly:
    # opened on the user's device, sign-in ends at the CLI's localhost
    # redirect port, which only exists inside this workspace.
    cat <<EOF

============================================================================
 The sign-in page is opening in the Zone's SECURE BROWSER -- a browser
 that runs INSIDE this workspace, not on your device.

     +--------------------------------------------------------------+
     |  Do NOT open any login.microsoftonline.com link printed      |
     |  above in your own browser. It will fail with a blank        |
     |  "localhost refused to connect" page after you sign in.      |
     +--------------------------------------------------------------+

 In JupyterLab, a "Zone Browser" tab opens automatically next to this
 one -- sign in THERE (MFA included) and this command will finish on
 its own. If the tab does not appear, click the blue "+" (Launcher)
 and open the "Zone Browser" tile.

 The browser shuts down by itself after ${TTL_MINUTES} idle minutes;
 run 'zone-browser --stop' to close it sooner.
============================================================================

EOF
}

do_status() {
    local name page
    for name in chromium viewer watchdog; do
        if pid_alive "$name"; then
            echo "$name: running (pid $(cat "$RUN_DIR/$name.pid"))"
        else
            echo "$name: not running"
        fi
    done
    [ -f "$RUN_DIR/viewer.port" ] && echo "viewer port: $(cat "$RUN_DIR/viewer.port")"
    page="$(link_path)"
    [ -n "${ZONE_EXTERNAL_URL:-}" ] && page="${ZONE_EXTERNAL_URL%/}${page}"
    echo "viewer path: ${page}"
    return 0
}

do_serve() {
    # jupyter-server-proxy entry point: run the CDP viewer bridge in the
    # FOREGROUND on the port jupyter-server-proxy assigned. This backs the
    # "Zone Browser" Launcher tile that renders the in-pod Chromium as a tab
    # inside JupyterLab.
    local port="${1:-}"
    case "$port" in
    '' | *[!0-9]*)
        echo "usage: zone-browser --serve <port>" >&2
        return 2
        ;;
    esac
    # Chromium is NOT started here: Lab frontends hold the bridge's /events
    # channel open all session, so the bridge must stay cheap. The viewer
    # starts Chromium on demand (zone-browser --ensure).
    echo $$ >"$RUN_DIR/viewer.pid"
    echo "$port" >"$RUN_DIR/viewer.port"
    exec python3 "$VIEWER" --serve "$port"
}

do_ensure() {
    seed_nss_certs
    ensure_chromium || return 1
    touch "$RUN_DIR/last-used"
    start_watchdog
    return 0
}

do_dump() {
    # Capture what the in-pod browser is showing right now (screenshot, page
    # HTML, URL) into a support bundle -- the first thing to ask for when a
    # user reports a blank or stuck sign-in page.
    local vport=""
    if ! pid_alive chromium; then
        echo "zone-browser: the browser is not running (nothing to dump)" >&2
        return 1
    fi
    [ -f "$RUN_DIR/viewer.port" ] && vport="$(cat "$RUN_DIR/viewer.port")"
    if [ -n "$vport" ] && curl -fsS -m 20 -X POST "http://127.0.0.1:${vport}/dump" 2>/dev/null; then
        echo
        return 0
    fi
    python3 "$VIEWER" --dump
}

do_selftest() {
    local chrome test_port=6089
    chrome="$(find_chromium)"
    if [ -z "$chrome" ] || [ ! -x "$chrome" ]; then
        echo "zone-browser selftest: FAIL (bundled Chromium not found)" >&2
        return 1
    fi
    "$chrome" --version || return 1
    do_ensure || return 1
    setsid "$SELF" --serve "$test_port" </dev/null >>"$RUN_DIR/viewer.log" 2>&1 &
    if ! wait_for "viewer on port ${test_port}" port_open "$test_port"; then
        do_stop
        return 1
    fi
    if ! curl -fsS "http://127.0.0.1:${test_port}/" | grep -q "Zone Browser"; then
        echo "zone-browser selftest: FAIL (viewer page not served)" >&2
        do_stop
        return 1
    fi
    if ! curl -fsS -X POST --data-urlencode "url=about:blank" \
        "http://127.0.0.1:${test_port}/open" >/dev/null; then
        echo "zone-browser selftest: FAIL (viewer cannot drive Chromium)" >&2
        do_stop
        return 1
    fi
    do_stop
    echo "zone-browser selftest: OK"
    return 0
}

open_url() {
    local url="$1" vport=""
    do_ensure || return 1
    # Prefer the viewer bridge: it tells every JupyterLab frontend to open
    # the Zone Browser tab (/events) and navigates the shared Chromium so an
    # attached tab updates live. Fall back to a one-shot DevTools call.
    [ -f "$RUN_DIR/viewer.port" ] && vport="$(cat "$RUN_DIR/viewer.port")"
    if [ -z "$vport" ] || ! curl -fsS -m 5 -X POST --data-urlencode "url=$url" \
        "http://127.0.0.1:${vport}/open" >/dev/null 2>&1; then
        python3 "$VIEWER" --navigate "$url" || return 1
    fi
    print_banner
    return 0
}

case "${1:-}" in
    --stop) do_stop ;;
    --status) do_status ;;
    --ensure) do_ensure ;;
    --dump) do_dump ;;
    --serve) do_serve "${2:-}" ;;
    --selftest) do_selftest ;;
    --help | -h) usage ;;
    -*)
        echo "zone-browser: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    *) open_url "${1:-https://microsoft.com/devicelogin}" ;;
esac
